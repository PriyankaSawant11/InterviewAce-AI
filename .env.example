# Agentic Interview Coach — API Keys
# Copy to .env and fill in your keys. Never commit .env to git!

# Groq  → https://console.groq.com       (free, 14,400 req/day)
# NVIDIA → https://build.nvidia.com       (free, 1,000 credits)
# Tavily → https://app.tavily.com/home    (free, 1,000 searches/month)

GROQ_API_KEY=gsk_your_groq_key_here
NVIDIA_API_KEY=nvapi-your_nvidia_key_here
TAVILY_API_KEY=tvly-your_tavily_key_here
